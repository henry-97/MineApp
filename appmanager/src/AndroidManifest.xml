<?xml version="1.0" encoding="utf-8"?>
<!-- 由 tools/gen_manifest.py 生成，不要手改；改完跑一次 gen_manifest.py。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.henry.appmanager"
    android:versionCode="235"
    android:versionName="5.2">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- 应用管理器必须能列出全部应用才能取到真实应用名（否则 Android 11+ 只返回
         与自身有交互的少数包，绝大多数应用只能显示包名） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Shizuku：客户端侧只需要这两个声明，provider 组件由对方 App 提供 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:label="Mine App"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <!-- 🔴 必须声明这个 provider：Shizuku 是通过它把 binder 交给客户端的。
             不声明的话 pingBinder() 恒为 false —— 表现为「Shizuku 里已授权，
             但 App 一直说 Shizuku 未运行」，PC 端授权了也会显示「调试未连接」。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.henry.appmanager.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name="com.henry.appmanager.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 命令中继：给同签名的 Lighto 复用 shell 通道。
             🔴 authority 只能各版本写一个（com.henry.appmanager.relay 由脚本按版本拼）：
                两个版本若声明同一个 authority，先装的会占住，后装的直接
                INSTALL_FAILED_CONFLICTING_PROVIDER —— 而这两个版本本来是要共存的。
             🔴 android:name 必须是全限定类名：多通道版走 aapt2 的 rename-manifest-package，
                相对名会被改写成 com.henry.appmanager.multi.RelayProvider，类不存在。 -->
        <provider
            android:name="com.henry.appmanager.RelayProvider"
            android:authorities="com.henry.appmanager.relay"
            android:exported="true"
            android:enabled="true" />

        <!-- 同一个中继的「第三方授权」入口：不带清单权限，靠 RelayProvider 里的
             运行期校验（包名在白名单 + 当前签名指纹与授权时一致）把关。
             单独开一个 authority 而不是把上面那层的权限去掉，是为了保住
             「同签名应用之外的调用连 Binder 都进不来」这道硬隔离。 -->
        <provider
            android:name="com.henry.appmanager.RelayOpenProvider"
            android:authorities="com.henry.appmanager.relay2"
            android:exported="true"
            android:enabled="true" />

        <!-- 12 个桌面入口：名称 × 图标，同一时间只启用一个 -->
        <activity-alias
            android:name=".AliasMineSqG"
            android:targetActivity="com.henry.appmanager.MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="Mine App"
            android:icon="@mipmap/ic_launcher_sq_g"
            android:roundIcon="@mipmap/ic_launcher_sq_g">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasMineSqY"
            android:targetActivity="com.henry.appmanager.MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="Mine App"
            android:icon="@mipmap/ic_launcher_sq_y"
