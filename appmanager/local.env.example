# 复制成 local.env 后按自己的路径改；这个文件不会进仓库
export ANDROID_SDK="/path/to/Android/Sdk"
export JAVA_HOME="/path/to/jdk-17"
export PYTHON="python3"

# 不填就自动在 appmanager/ 下生成 release.keystore
# export KEYSTORE="$PWD/release.keystore"
export KS_PASS="android"
export KEY_PASS="android"
export KEY_ALIAS="appmanager"
